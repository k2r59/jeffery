<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Jeffrey</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>spotify</string>
		<string>deezer</string>
		<string>music</string>
		<string>youtubemusic</string>
		<string>soundcloud</string>
	</array>
	<key>NSAppleMusicUsageDescription</key>
	<string>Jeffrey affiche le titre en cours et te laisse le mettre en pause ou passer au suivant pendant la séance.</string>
	<key>NSHealthShareUsageDescription</key>
	<string>Jeffrey lit tes données d'entraînement pour te coacher en direct.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>Jeffrey peut lancer une séance sur ta montre.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Jeffrey enregistre le tracé GPS de ta séance et calcule distance et allure si la montre ne les fournit pas.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Jeffrey t'écoute pour dialoguer avec toi pendant la séance.</string>
	<key>NSMotionUsageDescription</key>
	<string>Jeffrey détecte si tu marches, cours ou t'arrêtes, ta cadence et le relief, pour réagir au bon moment.</string>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>location</string>
	</array>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
</dict>
</plist>
